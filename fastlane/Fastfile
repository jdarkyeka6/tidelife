APP_IDENTIFIER = "com.jake.tidelife"

default_platform(:ios)

platform :ios do
  desc "Create or download TideLife's App Store provisioning profile"
  lane :prepare_profile do
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id = ENV["APPLE_TEAM_ID"].to_s.strip
    key_path = ENV["ASC_KEY_PATH"].to_s.strip

    missing = []
    missing << "ASC_KEY_ID" if key_id.empty?
    missing << "ASC_ISSUER_ID" if issuer_id.empty?
    missing << "APPLE_TEAM_ID" if team_id.empty?
    missing << "ASC_KEY_PATH" if key_path.empty?
    UI.user_error!("Missing Apple CI value(s): #{missing.join(', ')}") unless missing.empty?

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: team_id,
      provisioning_name: "TideLife App Store",
      skip_certificate_verification: true,
      force: false,
      output_path: ENV.fetch("RUNNER_TEMP", "."),
      filename: "TideLife_AppStore.mobileprovision"
    )

    UI.success("TideLife App Store provisioning profile is installed on the runner")
  end

  desc "One-time: use existing ASC key to create a local Apple Distribution identity for TideLife"
  lane :bootstrap_signing do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    key_path = ENV.fetch("ASC_KEY_PATH")
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    # cert will never revoke an existing distribution certificate. It only
    # creates one if no usable local identity exists, and Apple permits it.
    cert(
      api_key: api_key,
      team_id: team_id,
      generate_apple_certs: true,
      development: false,
      force: false,
      output_path: ENV.fetch("RUNNER_TEMP", ".")
    )

    profile_uuid = sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: team_id,
      provisioning_name: "TideLife App Store",
      force: true,
      skip_certificate_verification: false,
      output_path: ENV.fetch("RUNNER_TEMP", "."),
      filename: "TideLife_AppStore.mobileprovision"
    )

    File.write(File.join(ENV.fetch("RUNNER_TEMP", "."), "tidelife-profile-uuid.txt"), profile_uuid)
    UI.success("Installed distribution certificate and matching profile")
  end

end
